{
    "compilerOptions": {
        "types": ["mocha", "chai", "node"],
        "typeRoots": ["./node_modules/@types"],
        "lib": ["es2020"],
        "module": "esnext",
        "target": "es2020",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    }
}
